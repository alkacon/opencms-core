<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" 	
	xmlns:cms="urn:import:org.opencms.gwt.client.ui">
	
	<ui:style gss="true">
	
		@external oc-hide-availability-badge, oc-option-bar;
		.availabilityBadge  {
			color: white;
			font-weight: bold;
			position: absolute;
			top: 2px;
			right: 22px;
			pointer-events: none;
		}

		.availabilityBadge > * {
    		padding-left: 5px;
    		padding-right: 5px;
    		white-space: nowrap;
    		font-size: 12px;
		}

		.availabilityBadge > *:first-child {
    		border-top-left-radius: 5px;
    		border-top-right-radius: 5px;
		}

		.availabilityBadge > *:last-child {
    		border-bottom-left-radius: 5px;
    		border-bottom-right-radius: 5px;
		}

		.availabilityBadge .release {
    		background-color: #008489;
		}

		.availabilityBadge .expire {
    		background-color: #b31b34;
		}


		*[class*=cmsHovering] .availabilityBadge, .oc-option-bar.oc-hide-availability-badge .availabilityBadge {
    		display: none;
		}

	</ui:style>
	<g:FlowPanel ui:field="m_content" addStyleNames="{style.availabilityBadge}">
		<g:Label ui:field="m_releaseLabel" addStyleNames="{style.release}" />
		<g:Label ui:field="m_expireLabel" addStyleNames="{style.expire}" />
	</g:FlowPanel>
	
</ui:UiBinder> 